{
  "manifest_version": 3,
  "name": "Jiza Download Manager",
  "version": "1.0.0",
  "description": "Send downloads, links and videos to Jiza Download Manager for multi-connection speed.",
  "key": "",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Jiza Download Manager",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["downloads", "contextMenus", "nativeMessaging", "cookies", "storage", "webRequest", "tabs"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
