<Application x:Class="Jiza.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Jiza.App"
             ThemeMode="Dark"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Jiza cobalt-glass palette (JizaDesign.swift, dark appearance). -->
            <Color x:Key="SystemAccentColor">#315BEB</Color>
            <Color x:Key="SystemAccentColorLight1">#4C72F0</Color>
            <Color x:Key="SystemAccentColorLight2">#91B3FF</Color>
            <Color x:Key="SystemAccentColorLight3">#B8CDFF</Color>
            <Color x:Key="SystemAccentColorDark1">#2A4FCC</Color>
            <Color x:Key="SystemAccentColorDark2">#2240A8</Color>
            <Color x:Key="SystemAccentColorDark3">#1A3184</Color>

            <SolidColorBrush x:Key="JizaBackground" Color="#10182C" />
            <SolidColorBrush x:Key="JizaSurface" Color="#19243D" />
            <SolidColorBrush x:Key="JizaSurfaceRaised" Color="#213052" />
            <SolidColorBrush x:Key="JizaBorder" Color="#2C3D66" />
            <SolidColorBrush x:Key="JizaCobalt" Color="#315BEB" />
            <SolidColorBrush x:Key="JizaAccent" Color="#91B3FF" />
            <SolidColorBrush x:Key="JizaText" Color="#EEF2FF" />
            <SolidColorBrush x:Key="JizaMuted" Color="#9AA8C7" />
            <SolidColorBrush x:Key="JizaSuccess" Color="#5BD68A" />
            <SolidColorBrush x:Key="JizaDanger" Color="#FF7A7A" />
            <SolidColorBrush x:Key="JizaWarning" Color="#FFC966" />
            <SolidColorBrush x:Key="JizaTrack" Color="#213052" />
            <SolidColorBrush x:Key="JizaFilament" Color="#FFB547" />
            <FontFamily x:Key="DataFont">Cascadia Mono, Consolas</FontFamily>
            <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
            <RadialGradientBrush x:Key="JizaBackdrop" Center="1,0" GradientOrigin="1,0" RadiusX="0.9" RadiusY="1.2">
                <GradientStop Color="#3A315BEB" Offset="0" />
                <GradientStop Color="#0010182C" Offset="1" />
            </RadialGradientBrush>

            <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

            <local:BytesConverter x:Key="Bytes" />
            <local:SpeedConverter x:Key="Speed" />
            <local:EtaConverter x:Key="Eta" />
            <local:PercentConverter x:Key="Percent" />
            <local:StateBrushConverter x:Key="StateBrush" />
            <local:CategoryGlyphConverter x:Key="CategoryGlyph" />
            <BooleanToVisibilityConverter x:Key="Visible" />

            <!-- Toolbar button: glyph over a short label, like IDM's toolbar. -->
            <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="MinWidth" Value="68" />
                <Setter Property="Margin" Value="2,0" />
                <Setter Property="Foreground" Value="{DynamicResource JizaText}" />
            </Style>
            <Style x:Key="Glyph" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Icons}" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
            <Style x:Key="Caption" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource JizaMuted}" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource JizaSurface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource JizaBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="14" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
