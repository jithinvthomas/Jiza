<Window x:Class="Jiza.App.SchedulerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scheduler" Width="520" SizeToContent="Height" ResizeMode="NoResize" Icon="Assets/jiza.png"
        Background="{DynamicResource JizaBackground}" WindowStartupLocation="CenterOwner">
    <Grid Background="{DynamicResource JizaBackdrop}">
        <StackPanel Margin="20">
            <TextBlock Text="Scheduler" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="QueueText" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <CheckBox x:Name="EnabledBox" Content="Run the scheduler queue automatically" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Start at (HH:mm)" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                            <TextBox x:Name="StartBox" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <CheckBox x:Name="StopEnabled" Content="Stop at (HH:mm)" Margin="0,0,0,2" />
                            <TextBox x:Name="StopBox" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Days" Style="{StaticResource Caption}" Margin="0,14,0,6" />
                    <WrapPanel x:Name="DaysPanel" />
                    <TextBlock Text="When the queue finishes" Style="{StaticResource Caption}" Margin="0,14,0,6" />
                    <ComboBox x:Name="WhenDoneBox" HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource JizaDanger}" Margin="0,10,0,0" />
            <DockPanel Margin="0,10,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="Start queue now" Click="OnStartNow" Margin="0,0,8,0" />
                <Button DockPanel.Dock="Left" Content="Stop queue" Click="OnStopNow" />
                <Button DockPanel.Dock="Right" Content="Save" IsDefault="True" MinWidth="90" Background="{DynamicResource JizaCobalt}" Foreground="White" Click="OnSave" />
                <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" MinWidth="90" Margin="0,0,8,0" />
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
