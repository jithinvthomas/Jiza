<Window x:Class="Jiza.App.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jiza Download Manager license" Width="700" Height="640" MinWidth="520" MinHeight="420" Icon="Assets/jiza.png"
        Background="{DynamicResource JizaBackground}" WindowStartupLocation="CenterScreen">
    <Grid Background="{DynamicResource JizaBackdrop}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="22,20,22,0">
            <TextBlock x:Name="Heading" Text="Before you start" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}" />
            <TextBlock x:Name="Intro" Style="{StaticResource Caption}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="Jiza Download Manager is free to use. Please read the license; choosing I agree accepts it." />
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="22,14,22,0" Padding="0">
            <TextBox x:Name="Body" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"
                     FontFamily="{StaticResource DataFont}" FontSize="12.5" Padding="16" AutomationProperties.Name="License text" />
        </Border>
        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="22,14,22,18">
            <Button x:Name="DeclineButton" Content="Decline and exit" MinWidth="130" Margin="8,0,0,0" Click="OnDecline" />
            <Button x:Name="AgreeButton" Content="I agree" MinWidth="110" Margin="8,0,0,0" IsDefault="True"
                    Background="{DynamicResource JizaCobalt}" Foreground="White" Click="OnAgree" />
        </WrapPanel>
    </Grid>
</Window>
