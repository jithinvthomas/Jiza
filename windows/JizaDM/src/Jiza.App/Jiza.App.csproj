<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Jiza.Core\Jiza.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>JizaDM</AssemblyName>
    <RootNamespace>Jiza.App</RootNamespace>
    <ApplicationIcon>Assets\jiza.ico</ApplicationIcon>
    <Product>Jiza Download Manager</Product>
    <Version>1.0.1</Version>
    <!-- Fluent ThemeMode is marked experimental in WPF. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only used for the tray icon; keep WPF types unambiguous. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\jiza.png" />
    <EmbeddedResource Include="Assets\jiza.ico" LogicalName="jiza.ico" />
    <EmbeddedResource Include="..\..\LICENSE.txt" LogicalName="license.txt" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.txt" LogicalName="notices.txt" />
    <!-- The browser extension ships inside the exe and is unpacked to %AppData%\JizaDM\extension. -->
    <EmbeddedResource Include="..\..\extension\**\*" LogicalName="extension/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
