<Window x:Class="Jiza.App.AddUrlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add download" Width="640" SizeToContent="Height" ResizeMode="NoResize" Icon="Assets/jiza.png"
        Background="{DynamicResource JizaBackground}" WindowStartupLocation="CenterScreen" Topmost="True">
    <Grid Background="{DynamicResource JizaBackdrop}">
        <StackPanel Margin="20">
            <TextBlock Text="Address" Style="{StaticResource Caption}" Margin="0,0,0,6" />
            <DockPanel>
                <Button x:Name="AnalyzeButton" DockPanel.Dock="Right" Content="Check link" Margin="8,0,0,0" Click="OnAnalyze" />
                <TextBox x:Name="UrlBox" TextChanged="OnUrlChanged" ToolTip="Any link: file, video page, stream (.m3u8), magnet, .torrent or FTP" />
            </DockPanel>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <DockPanel>
                        <Border x:Name="KindBadge" DockPanel.Dock="Left" Background="{DynamicResource JizaCobalt}" CornerRadius="6" Padding="8,2" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock x:Name="KindText" Text="Link" FontSize="12" Foreground="White" />
                        </Border>
                        <TextBlock x:Name="SizeText" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <TextBlock x:Name="ResumeText" Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <ProgressBar x:Name="Busy" IsIndeterminate="True" Height="3" Margin="0,10,0,0" Visibility="Collapsed" />
                    <TextBlock x:Name="NoteText" TextWrapping="Wrap" Margin="0,10,0,0" Style="{StaticResource Caption}" Visibility="Collapsed" />

                    <TextBlock Text="Save as" Style="{StaticResource Caption}" Margin="0,14,0,6" />
                    <TextBox x:Name="NameBox" />

                    <StackPanel x:Name="QualityPanel" Visibility="Collapsed">
                        <TextBlock Text="Quality" Style="{StaticResource Caption}" Margin="0,14,0,6" />
                        <ComboBox x:Name="QualityBox" DisplayMemberPath="Label" HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Category" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                            <ComboBox x:Name="CategoryBox" SelectionChanged="OnCategoryChanged" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Folder" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Browse..." Margin="8,0,0,0" Click="OnBrowse" />
                                <TextBox x:Name="FolderBox" TextChanged="OnFolderEdited" />
                            </DockPanel>
                        </StackPanel>
                    </Grid>

                    <Expander Header="Advanced" Margin="0,14,0,0">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,6">
                                <Run Text="Connections:" /> <Run x:Name="ConnectionsText" />
                            </TextBlock>
                            <Slider x:Name="ConnectionsSlider" Minimum="1" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnConnectionsChanged" />
                            <TextBlock Text="Speed limit for this download (KB/s, 0 = none)" Style="{StaticResource Caption}" Margin="0,10,0,6" />
                            <TextBox x:Name="LimitBox" Text="0" />
                            <TextBlock Text="Referrer" Style="{StaticResource Caption}" Margin="0,10,0,6" />
                            <TextBox x:Name="ReferrerBox" />
                            <TextBlock Text="Cookies (filled in automatically when the browser sends the download)" Style="{StaticResource Caption}" Margin="0,10,0,6" />
                            <TextBox x:Name="CookiesBox" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource JizaDanger}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" MinWidth="90" Click="OnCancel" />
                <Button x:Name="LaterButton" Content="Download later" Margin="0,0,8,0" MinWidth="120" Click="OnLater" />
                <Button x:Name="StartButton" Content="Start download" IsDefault="True" MinWidth="130" Background="{DynamicResource JizaCobalt}" Foreground="White" Click="OnStart" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
